    <string name="app_name">Hyper Glass Keyboard</string>
    <string name="settings_label">Hyper Glass · Configurações</string>
    <string name="settings_title">Hyper Glass Keyboard</string>
    <string name="settings_intro">Teclado IME completo em estilo glass: QWERTY ABNT2, números, símbolos, emoji, acentos por toque longo, sugestões que aprendem com seu uso, shift/caps lock, backspace com repetição, colagem e atalhos de tema.\n\n1) Toque em “Ativar teclado” e habilite Hyper Glass Keyboard.\n2) Em Configurações do sistema › Idioma e entrada, selecione Hyper Glass Keyboard.\n3) Toque no ícone ◐ na barra do teclado para trocar o tema.</string>
